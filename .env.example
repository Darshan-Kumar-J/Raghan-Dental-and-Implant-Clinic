# GEMINI_API_KEY: Optional Gemini API key if AI features are added later.
GEMINI_API_KEY=""

# APP_URL: Public base URL of the deployed clinic website (used in canonicals, sitemap.xml, and links).
APP_URL="http://localhost:3000"

# SUPABASE_URL: Your Supabase project URL (https://<project-id>.supabase.co)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Your Supabase publishable / anon API key
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# SUPABASE_SECRET_KEY: Optional Supabase service_role / secret key for admin updates & reads from Supabase
SUPABASE_SECRET_KEY=""

# ADMIN_AUTH_SECRET: Secret key used to sign clinic admin session cookies (set a strong random string in production).
ADMIN_AUTH_SECRET="change-this-to-a-strong-random-secret"

# ADMIN_EMAIL / ADMIN_PASSWORD: Initial clinic administrator login credentials.
ADMIN_EMAIL="admin@raghandental.in"
ADMIN_PASSWORD="ChangeMeClinicAdmin2026!"

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Optional Razorpay credentials for online consultation fee payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# WHATSAPP_API_TOKEN / WHATSAPP_PHONE_NUMBER_ID: Optional Meta WhatsApp Cloud API credentials for automated confirmations.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# RESEND_API_KEY / CLINIC_NOTIFICATION_EMAIL: Optional email notification credentials.
RESEND_API_KEY=""
CLINIC_NOTIFICATION_EMAIL=""
